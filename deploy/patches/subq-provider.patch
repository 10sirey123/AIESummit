diff --git a/Blueshift.Agents/LLM/SubQ/SubQAPI.cs b/Blueshift.Agents/LLM/SubQ/SubQAPI.cs
new file mode 100644
index 0000000..fd6c006
--- /dev/null
+++ b/Blueshift.Agents/LLM/SubQ/SubQAPI.cs
@@ -0,0 +1,37 @@
+using System.Net.Http.Headers;
+using Blueshift.Agents.LLM.OpenAI;
+using Blueshift.Domain.Entities;
+
+namespace Blueshift.Agents.LLM.SubQ;
+
+/// <summary>SubQ Model API using the shared Responses protocol and persisted APIInfo credentials.</summary>
+public class SubQAPI : OpenAIAPI
+{
+    public SubQAPI() { }
+    public SubQAPI(HttpClient client) : base(client) { }
+
+    public override string APIIdentifier => "subq";
+    protected override LLMAPIProvider Provider => LLMAPIProvider.SubQ;
+
+    protected override void ConfigureAuthentication(HttpClient client)
+    {
+        client.DefaultRequestHeaders.Remove("api-key");
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AppKey);
+    }
+
+    protected override string GetResponsesEndpoint()
+    {
+        var endpoint = AzureEndpoint ?? ApiBaseUri?.ToString();
+        if (!Uri.TryCreate(endpoint, UriKind.Absolute, out var uri)
+            || uri.Scheme != Uri.UriSchemeHttps || uri.Host != "api.subq.ai"
+            || !uri.IsDefaultPort || !string.IsNullOrEmpty(uri.UserInfo)
+            || !string.IsNullOrEmpty(uri.Query) || !string.IsNullOrEmpty(uri.Fragment)
+            || uri.AbsolutePath.TrimEnd('/') is not ("" or "/v1" or "/v1/responses"))
+            throw new InvalidOperationException("SubQ APIInfo.BaseURI must be https://api.subq.ai/v1.");
+
+        return "https://api.subq.ai/v1/responses";
+    }
+
+    protected override string GetAudioTranscriptionsEndpoint()
+        => throw new NotSupportedException("SubQ audio transcription is not supported by this adapter. Use text or image inputs through LLMPrompt.");
+}
