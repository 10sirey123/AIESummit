diff --git a/Blueshift.Agents/LLM/Meta/MetaAPI.cs b/Blueshift.Agents/LLM/Meta/MetaAPI.cs
new file mode 100644
index 0000000..d10991f
--- /dev/null
+++ b/Blueshift.Agents/LLM/Meta/MetaAPI.cs
@@ -0,0 +1,37 @@
+using System.Net.Http.Headers;
+using Blueshift.Agents.LLM.OpenAI;
+using Blueshift.Domain.Entities;
+
+namespace Blueshift.Agents.LLM.Meta;
+
+/// <summary>Meta Model API using the shared Responses protocol and persisted APIInfo credentials.</summary>
+public class MetaAPI : OpenAIAPI
+{
+    public MetaAPI() { }
+    public MetaAPI(HttpClient client) : base(client) { }
+
+    public override string APIIdentifier => "meta";
+    protected override LLMAPIProvider Provider => LLMAPIProvider.Meta;
+
+    protected override void ConfigureAuthentication(HttpClient client)
+    {
+        client.DefaultRequestHeaders.Remove("api-key");
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AppKey);
+    }
+
+    protected override string GetResponsesEndpoint()
+    {
+        var endpoint = AzureEndpoint ?? ApiBaseUri?.ToString();
+        if (!Uri.TryCreate(endpoint, UriKind.Absolute, out var uri)
+            || uri.Scheme != Uri.UriSchemeHttps || uri.Host != "api.meta.ai"
+            || !uri.IsDefaultPort || !string.IsNullOrEmpty(uri.UserInfo)
+            || !string.IsNullOrEmpty(uri.Query) || !string.IsNullOrEmpty(uri.Fragment)
+            || uri.AbsolutePath.TrimEnd('/') is not ("" or "/v1" or "/v1/responses"))
+            throw new InvalidOperationException("Meta APIInfo.BaseURI must be https://api.meta.ai/v1.");
+
+        return "https://api.meta.ai/v1/responses";
+    }
+
+    protected override string GetAudioTranscriptionsEndpoint()
+        => throw new NotSupportedException("Meta audio transcription is not supported by this adapter. Use text or image inputs through LLMPrompt.");
+}
