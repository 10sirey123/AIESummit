{
  "openapi": "3.0.3",
  "info": {
    "title": "AIESummit App API",
    "version": "1.0.0",
    "description": "Upload files and retrieve OCR documents in your own workspace.",
    "contact": {
      "name": "AIESummit maintainers"
    }
  },
  "tags": [
    {
      "name": "Uploads"
    },
    {
      "name": "Extractions",
      "description": "Owner-scoped contract findings, evidence and evaluation metrics"
    }
  ],
  "security": [
    {
      "FirebaseBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "FirebaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "ExtractionTypeList": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "benchmarkCategory": {
              "type": "string"
            },
            "instructions": {
              "type": "string"
            },
            "parametersJson": {
              "type": "string"
            },
            "definitionVersion": {
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      },
      "ExtractionAccepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "requestKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "requestKey"
        ]
      },
      "ExtractionEvidence": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageTextRevisionId": {
            "type": "integer"
          },
          "contentHash": {
            "type": "string"
          },
          "startOffset": {
            "type": "integer"
          },
          "endOffset": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "qualification",
              "definition"
            ]
          },
          "supportedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "page",
          "pageTextRevisionId",
          "contentHash",
          "startOffset",
          "endOffset",
          "quote",
          "role",
          "supportedFields"
        ]
      },
      "ExtractionFinding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer"
          },
          "reviewState": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": true,
            "description": "Versioned allowed fields are specified by the extraction target; ISO dates, decimal amounts/durations and explicit currency/unit."
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtractionEvidence"
            }
          }
        }
      },
      "ExtractionTargetResult": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "not_analyzed",
              "detected",
              "not_found_in_reviewed_text",
              "uncertain",
              "not_applicable"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "extractions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtractionFinding"
            }
          }
        }
      },
      "ExtractionResults": {
        "type": "object",
        "properties": {
          "analyses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "documentId": {
                  "type": "integer"
                },
                "isCurrent": {
                  "type": "boolean"
                },
                "requestKey": {
                  "type": "string"
                },
                "inputHash": {
                  "type": "string"
                },
                "completedAt": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "error": {
                  "type": "string",
                  "nullable": true
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "analyzing",
                    "failed"
                  ]
                },
                "definitions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExtractionTargetResult"
                  }
                },
                "modelReportedOutcomes": {
                  "type": "array",
                  "description": "Diagnostic model classifications, including rejected outputs; never validated findings.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tag": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string"
                      },
                      "evidenceValidated": {
                        "type": "boolean",
                        "enum": [
                          false
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "analyses"
        ]
      },
      "ExtractionMetrics": {
        "type": "object",
        "properties": {
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "description": "Prompt ID/subject, step/model/provider identifiers, nullable provider revision, prompt/schema hashes, input/output/total/accumulated token counters, API attempts, processing status and persistence timestamps."
            }
          },
          "reportedInputTokens": {
            "type": "integer"
          },
          "reportedOutputTokens": {
            "type": "integer"
          },
          "reportedTotalTokens": {
            "type": "integer"
          },
          "accumulatedTokens": {
            "type": "integer"
          },
          "ocrTokens": {
            "type": "integer",
            "nullable": true
          },
          "inputOutputBreakdownAvailable": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "AcceptedUpload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      },
      "Upload": {
        "type": "object",
        "required": [
          "id",
          "fileName",
          "created",
          "pageCount",
          "status",
          "error"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "fileName": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "pageCount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "splitting",
              "ready",
              "failed"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UploadDetail": {
        "type": "object",
        "required": [
          "upload",
          "documents",
          "pages"
        ],
        "properties": {
          "upload": {
            "$ref": "#/components/schemas/Upload"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OcrPage"
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "title",
          "firstPage",
          "lastPage",
          "markdown",
          "images"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "firstPage": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "lastPage": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "markdown": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageReference"
            }
          }
        }
      },
      "ImageReference": {
        "type": "object",
        "required": [
          "id",
          "page",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "OcrPage": {
        "type": "object",
        "required": [
          "id",
          "number",
          "markdown",
          "analysisStatus",
          "error",
          "sections"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "markdown": {
            "type": "string"
          },
          "analysisStatus": {
            "type": "string",
            "enum": [
              "not_started",
              "analyzing",
              "ready",
              "failed"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageSection"
            }
          }
        }
      },
      "PageSection": {
        "type": "object",
        "required": [
          "heading",
          "classification",
          "summary",
          "quote"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/extraction-types": {
      "get": {
        "operationId": "listExtractionTypes",
        "summary": "List configured extraction targets",
        "tags": [
          "Extractions"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "List configured extraction targets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionTypeList"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/uploads/{id}/extractions": {
      "get": {
        "operationId": "getExtractions",
        "summary": "Get owner-scoped analyses, validated findings and explicitly unvalidated model presence outcomes",
        "tags": [
          "Extractions"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get owner-scoped analyses, validated findings and explicitly unvalidated model presence outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResults"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Upload not found for this owner"
          }
        }
      },
      "post": {
        "operationId": "startExtractions",
        "summary": "Idempotently request extraction for current logical documents",
        "tags": [
          "Extractions"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "requestKey",
            "in": "query",
            "description": "Same document/key reuses an existing analysis; use a new key for a deliberate reanalysis.",
            "schema": {
              "type": "string",
              "default": "initial",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Idempotently request extraction for current logical documents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Upload not found for this owner"
          },
          "409": {
            "description": "Processing prerequisites are not ready"
          }
        }
      }
    },
    "/api/v1/uploads/{id}/metrics": {
      "get": {
        "operationId": "getUploadMetrics",
        "summary": "Get owner-scoped prompt token counters, model identifiers and definition hashes; no prompt text",
        "tags": [
          "Extractions"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get owner-scoped prompt token counters, model identifiers and definition hashes; no prompt text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionMetrics"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Upload not found for this owner"
          }
        }
      }
    },
    "/api/v1/uploads": {
      "get": {
        "operationId": "listUploads",
        "summary": "List the signed-in user's uploads, newest first",
        "tags": [
          "Uploads"
        ],
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "description": "List uploads with IDs lower than this cursor",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 50 uploads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Upload"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token required"
          }
        },
        "description": "Returns a page of up to 50 owned uploads. Pass the last ID as before to retrieve older uploads."
      },
      "post": {
        "operationId": "createUpload",
        "summary": "Queue a PDF, PNG or JPEG for analysis",
        "tags": [
          "Uploads"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "A file up to 20 MiB. PDF files can contain up to 30 pages."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedUpload"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Upload detail path"
              }
            }
          },
          "400": {
            "description": "Missing, empty or oversized file"
          },
          "401": {
            "description": "Firebase ID token required"
          },
          "413": {
            "description": "Request exceeds the body limit"
          },
          "415": {
            "description": "Unsupported file type"
          }
        },
        "description": "Accepts one multipart file and starts background OCR and document splitting.",
        "parameters": [
          {
            "name": "pageSections",
            "in": "query",
            "description": "Run the independent per-page section summaries. Defaults to true; the extraction evaluator sets false. OCR, splitting and contract extraction still run.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ]
      }
    },
    "/api/v1/uploads/{id}": {
      "get": {
        "operationId": "getUpload",
        "summary": "Get status and document results for an upload",
        "tags": [
          "Uploads"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload and documents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDetail"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token required"
          },
          "404": {
            "description": "Upload or image unavailable for this account"
          }
        },
        "description": "Returns the current processing status, document ranges, Markdown, and image references."
      }
    },
    "/api/v1/uploads/{id}/images/{imageId}": {
      "get": {
        "operationId": "getImage",
        "summary": "Download an OCR image from an owned upload",
        "tags": [
          "Uploads"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "imageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token required"
          },
          "404": {
            "description": "Upload or image unavailable for this account"
          }
        },
        "description": "Returns an extracted image that belongs to the specified upload."
      }
    },
    "/api/v1/uploads/{id}/source": {
      "get": {
        "operationId": "getOriginalSource",
        "summary": "Read the owned original file bytes",
        "tags": [
          "Uploads"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original PDF, PNG or JPEG; private and not cached",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Original file byte range"
          },
          "401": {
            "description": "Firebase authentication required"
          },
          "404": {
            "description": "Upload not found for this owner"
          }
        }
      }
    },
    "/api/v1/uploads/{id}/analyze": {
      "post": {
        "operationId": "analyzeUploadPages",
        "summary": "Queue unanalysed owned OCR pages using the configured native Blueshift page step",
        "tags": [
          "Uploads"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Eligible pages queued; inspect per-page status on the detail endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedUpload"
                }
              }
            }
          },
          "401": {
            "description": "Firebase authentication required"
          },
          "404": {
            "description": "Upload not found for this owner"
          },
          "409": {
            "description": "Selected model APIInfo or page LLMStep is not configured/enabled"
          }
        }
      }
    }
  }
}
