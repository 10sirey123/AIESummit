{
  "ExtractionTypeList": {
    "type": "array",
    "items": {
      "$ref": "#/components/schemas/ExtractionTypeDefinition"
    }
  },
  "ExtractionAccepted": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "requestKey": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "requestKey"
    ]
  },
  "ExtractionEvidence": {
    "type": "object",
    "properties": {
      "page": {
        "type": "integer"
      },
      "pageTextRevisionId": {
        "type": "integer"
      },
      "contentHash": {
        "type": "string"
      },
      "startOffset": {
        "type": "integer"
      },
      "endOffset": {
        "type": "integer"
      },
      "quote": {
        "type": "string"
      },
      "role": {
        "type": "string",
        "enum": [
          "primary",
          "qualification",
          "definition"
        ]
      },
      "supportedFields": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "modelQuote": {
        "type": "string",
        "description": "Original model quote, which may differ from the source quote for approximate matches; empty for legacy evidence."
      },
      "matchMethod": {
        "type": "string",
        "description": "exact or word-dice-50-v1"
      },
      "matchScore": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Multiset word Dice overlap; threshold 0.5 inclusive. Exact matches score 1."
      }
    },
    "required": [
      "page",
      "pageTextRevisionId",
      "contentHash",
      "startOffset",
      "endOffset",
      "quote",
      "role",
      "supportedFields"
    ]
  },
  "ExtractionFinding": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "schemaVersion": {
        "type": "integer"
      },
      "reviewState": {
        "type": "string"
      },
      "values": {
        "type": "object",
        "additionalProperties": true,
        "description": "Versioned allowed fields are specified by the extraction target; ISO dates, decimal amounts/durations and explicit currency/unit.",
        "x-target-value-schemas": {
          "agreement-effective-date": {
            "1": "#/components/schemas/EffectiveDateValuesV1"
          },
          "agreement-expiration": {
            "1": "#/components/schemas/ExpirationValuesV1"
          },
          "renewal-term": {
            "1": "#/components/schemas/RenewalValuesV1"
          },
          "non-renewal-notice": {
            "1": "#/components/schemas/NonRenewalNoticeValuesV1"
          },
          "non-compete": {
            "1": "#/components/schemas/NonCompeteValuesV1"
          },
          "termination-convenience": {
            "1": "#/components/schemas/ConvenienceTerminationValuesV1"
          },
          "liability-cap": {
            "1": "#/components/schemas/LiabilityCapValuesV1"
          },
          "uncapped-liability": {
            "1": "#/components/schemas/UncappedLiabilityValuesV1"
          },
          "audit-rights": {
            "1": "#/components/schemas/AuditRightsValuesV1"
          },
          "insurance-obligations": {
            "1": "#/components/schemas/InsuranceObligationsValuesV1"
          }
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExtractionEvidence"
        }
      }
    }
  },
  "ExtractionTargetResult": {
    "type": "object",
    "properties": {
      "tag": {
        "type": "string"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "not_analyzed",
          "detected",
          "not_found_in_reviewed_text",
          "uncertain",
          "not_applicable"
        ]
      },
      "explanation": {
        "type": "string"
      },
      "extractions": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExtractionFinding"
        }
      }
    }
  },
  "ExtractionResults": {
    "type": "object",
    "properties": {
      "analyses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "documentId": {
              "type": "integer"
            },
            "isCurrent": {
              "type": "boolean"
            },
            "requestKey": {
              "type": "string"
            },
            "inputHash": {
              "type": "string"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "error": {
              "type": "string",
              "nullable": true
            },
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "analyzing",
                "failed"
              ]
            },
            "definitions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "targets": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ExtractionTargetResult"
              }
            },
            "modelReportedOutcomes": {
              "type": "array",
              "description": "Diagnostic model classifications, including rejected outputs; never validated findings.",
              "items": {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string"
                  },
                  "evidenceValidated": {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "analyses"
    ]
  },
  "ExtractionMetrics": {
    "type": "object",
    "properties": {
      "prompts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "description": "Prompt ID/subject, step/model/provider identifiers, nullable provider revision, prompt/schema hashes, input/output/total/accumulated token counters, API attempts, processing status and persistence timestamps."
        }
      },
      "reportedInputTokens": {
        "type": "integer"
      },
      "reportedOutputTokens": {
        "type": "integer"
      },
      "reportedTotalTokens": {
        "type": "integer"
      },
      "accumulatedTokens": {
        "type": "integer"
      },
      "ocrTokens": {
        "type": "integer",
        "nullable": true
      },
      "inputOutputBreakdownAvailable": {
        "type": "boolean"
      },
      "note": {
        "type": "string"
      }
    }
  },
  "ExtractionTypeDefinition": {
    "type": "object",
    "properties": {
      "tag": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "benchmarkCategory": {
        "type": "string"
      },
      "instructions": {
        "type": "string"
      },
      "parametersJson": {
        "type": "string"
      },
      "definitionVersion": {
        "type": "integer"
      },
      "enabled": {
        "type": "boolean"
      },
      "parameters": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExtractionParameter"
        }
      },
      "schemaSupported": {
        "type": "boolean"
      },
      "valueSchemaDialect": {
        "type": "string",
        "enum": [
          "openapi-3.0"
        ]
      },
      "valueSchema": {
        "type": "object",
        "nullable": true,
        "additionalProperties": true,
        "description": "OpenAPI 3.0 Schema Object for this definition version; null when unsupported."
      }
    },
    "required": [
      "tag",
      "name",
      "benchmarkCategory",
      "instructions",
      "parametersJson",
      "definitionVersion",
      "enabled",
      "parameters",
      "schemaSupported",
      "valueSchemaDialect",
      "valueSchema"
    ]
  },
  "ExtractionParameter": {
    "type": "object",
    "required": [
      "name",
      "type",
      "description",
      "format",
      "allowedValues",
      "minimum",
      "exclusiveMinimum",
      "maxLength"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "enum": [
          "string",
          "number",
          "unknown"
        ]
      },
      "description": {
        "type": "string"
      },
      "format": {
        "type": "string",
        "nullable": true
      },
      "allowedValues": {
        "type": "array",
        "nullable": true,
        "items": {
          "type": "string"
        }
      },
      "minimum": {
        "type": "number",
        "nullable": true
      },
      "exclusiveMinimum": {
        "type": "boolean"
      },
      "maxLength": {
        "type": "integer",
        "nullable": true
      }
    }
  },
