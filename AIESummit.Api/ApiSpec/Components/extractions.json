              "failed",
              "ready",
              "not_requested",
              "not_started"
            ]
          }
        }
      },
      "extraction": {
        "type": "object",
        "required": [
          "status",
          "canPoll",
          "totalDocuments",
          "readyDocuments",
          "failedDocuments",
          "pendingDocuments",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "waiting_for_documents",
              "not_started",
              "analyzing",
              "ready",
              "partial_failure",
              "failed",
              "blocked",
              "incomplete"
            ]
          },
          "canPoll": {
            "type": "boolean"
          },
          "totalDocuments": {
            "type": "integer",
            "minimum": 0
          },
          "readyDocuments": {
            "type": "integer",
            "minimum": 0
          },
          "failedDocuments": {
            "type": "integer",
            "minimum": 0
          },
          "pendingDocuments": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "documents": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "firstPage",
            "lastPage",
            "analysis"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "firstPage": {
              "type": "integer"
            },
            "lastPage": {
              "type": "integer"
            },
            "analysis": {
              "$ref": "#/components/schemas/DocumentAnalysisSelection"
            }
          }
        }
      }
    }
  }
}
