{
  "AcceptedUpload": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      }
    }
  },
  "Upload": {
    "type": "object",
    "required": [
      "id",
      "fileName",
      "created",
      "pageCount",
      "status",
      "error"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "fileName": {
        "type": "string"
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "pageCount": {
        "type": "integer",
        "minimum": 0
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "splitting",
          "ready",
          "failed"
        ]
      },
      "error": {
        "type": "string",
        "nullable": true
      }
    }
  },
  "UploadDetail": {
    "type": "object",
    "required": [
      "upload",
      "documents",
      "pages"
    ],
    "properties": {
      "upload": {
        "$ref": "#/components/schemas/Upload"
      },
      "documents": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Document"
        }
      },
      "pages": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OcrPage"
        }
      }
    }
  },
  "Document": {
    "type": "object",
    "required": [
      "id",
      "title",
      "firstPage",
      "lastPage",
      "markdown",
      "images"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "title": {
        "type": "string"
      },
      "firstPage": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "lastPage": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "markdown": {
        "type": "string"
      },
      "images": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ImageReference"
        }
      }
    }
  },
  "ImageReference": {
    "type": "object",
    "required": [
      "id",
      "page",
      "reference"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "page": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "reference": {
        "type": "string"
      }
    }
  },
  "OcrPage": {
    "type": "object",
    "required": [
      "id",
      "number",
      "markdown",
      "analysisStatus",
      "error",
      "sections"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "number": {
        "type": "integer",
        "minimum": 1
      },
      "markdown": {
        "type": "string"
      },
      "analysisStatus": {
        "type": "string",
        "enum": [
          "not_started",
          "analyzing",
          "ready",
          "failed"
        ]
      },
      "error": {
        "type": "string",
        "nullable": true
      },
      "sections": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/PageSection"
        }
      }
    }
  },
  "PageSection": {
    "type": "object",
    "required": [
      "heading",
      "classification",
      "summary",
      "quote"
    ],
    "properties": {
      "heading": {
        "type": "string"
      },
      "classification": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "quote": {
        "type": "string"
      }
    }
  }
}
