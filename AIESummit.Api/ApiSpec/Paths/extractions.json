{
  "/api/v1/extraction-types": {
    "get": {
      "operationId": "listExtractionTypes",
      "summary": "List target definitions with structured parameter descriptors and versioned OpenAPI value schemas",
      "tags": [
        "Extractions"
      ],
      "parameters": [],
      "responses": {
        "200": {
          "description": "List configured extraction targets",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionTypeList"
              }
            }
          }
        },
        "401": {
          "description": "Authentication required"
        }
      }
    }
  },
  "/api/v1/uploads/{id}/extractions": {
    "get": {
      "operationId": "getExtractions",
      "summary": "Get owner-scoped analyses, validated findings and explicitly unvalidated model presence outcomes",
      "description": "Application analysis history excludes isolated self-improvement executions whose request keys use the reserved improvement/ prefix.",
      "tags": [
        "Extractions"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Get owner-scoped analyses, validated findings and explicitly unvalidated model presence outcomes",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionResults"
              }
            }
          }
        },
        "401": {
          "description": "Authentication required"
        },
        "404": {
          "description": "Upload not found for this owner"
        }
      }
    },
    "post": {
      "operationId": "startExtractions",
      "summary": "Idempotently request extraction for current logical documents",
      "tags": [
        "Extractions"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "requestKey",
          "in": "query",
          "description": "Same document/key reuses an existing analysis; use a new key for a deliberate reanalysis. The improvement/ prefix is reserved and returns 400.",
          "schema": {
            "type": "string",
            "default": "initial",
            "minLength": 1,
            "maxLength": 100
          }
        }
      ],
      "responses": {
        "202": {
          "description": "Idempotently request extraction for current logical documents",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionAccepted"
              }
            }
          }
        },
        "400": {
          "description": "Invalid request key or reserved improvement/ prefix"
        },
        "401": {
          "description": "Authentication required"
        },
        "404": {
          "description": "Upload not found for this owner"
        },
        "409": {
          "description": "Processing prerequisites are not ready"
        }
      }
    }
  },
  "/api/v1/uploads/{id}/metrics": {
    "get": {
      "operationId": "getUploadMetrics",
      "summary": "Get owner-scoped prompt token counters, model identifiers and definition hashes; no prompt text",
      "description": "Counters exclude isolated self-improvement execution prompts; experiment metrics are recorded by the improvement runner separately.",
      "tags": [
        "Extractions"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Get owner-scoped prompt token counters, model identifiers and definition hashes; no prompt text",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionMetrics"
              }
            }
          }
        },
        "401": {
          "description": "Authentication required"
        },
        "404": {
          "description": "Upload not found for this owner"
        }
      }
    }
  },
  "/api/v1/uploads/{id}/analysis-pages/{revisionId}": {
    "get": {
      "operationId": "getAnalysisPageSnapshot",
      "summary": "Get owner-scoped immutable page text for historical evidence highlighting",
      "tags": [
        "Extractions"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "revisionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Immutable page source and hash",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "analysisId": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer"
                  },
                  "contentHash": {
                    "type": "string"
                  },
                  "markdown": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "401": {
          "description": "Authentication required"
        },
        "404": {
          "description": "Snapshot not found for this upload and owner"
        }
      }
    }
  },
  "/api/v1/uploads/{id}/analysis-summary": {
    "get": {
      "operationId": "getUploadAnalysisSummary",
      "summary": "Get owner-scoped branch progress and latest/last-successful analysis selections without findings or prompts",
      "description": "Latest and last-successful selections exclude isolated self-improvement executions, preserving ordinary reader state.",
      "tags": [
        "Extractions"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Current-document processing summary; canPoll explicitly identifies continuing extraction work.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadAnalysisSummary"
              }
            }
          }
        },
        "401": {
          "description": "Authentication required"
        },
        "404": {
          "description": "Upload not found for this owner"
        }
      }
    }
  }
}
