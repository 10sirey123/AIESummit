AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
OCR_MODEL=mistral-ocr-4-0
LLM_MODEL=gpt-4.1-mini
FIREBASE_EMULATOR=true
FIREBASE_PROJECT_ID=demo-aiesummit
FIREBASE_API_KEY=demo-key
AIESUMMIT_API_ENVIRONMENT=Development

# Optional: explicitly import into APIInfo with the matching scripts/configure-*.ps1 helper.
# Runtime agents use persisted APIInfo, not these environment variables.
META_API_KEY=
GEMINI_API_KEY=
SUBQ_API_KEY=

# Optional tester instrumentation only. Never commit a populated URI.
MONGODB_URI=
MONGODB_DATABASE=aiesummit
MONGODB_HOST=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_CLUSTER=
MONGODB_ATLAS_PROJECT_ID=
MONGODB_ATLAS_ORG_ID=
